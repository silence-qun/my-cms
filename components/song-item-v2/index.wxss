/* components/song-item-v2/index.wxss */
.item {
  display: flex;
  align-items: center;
  margin: 36rpx 0 10rpx;
  gap: 16rpx;
}
.index {
  font-size: 30rpx;
  padding: 12rpx;
}
.info {
  flex: 1;
}
.info .name {
  font-size: 30rpx;
}
.info .source {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #666;
  margin-top: 10rpx;
  gap: 10rpx;
}
.source .icon {
  width: 40rpx;
  height: 30rpx;
}
