<!--components/song-detail-header/index.wxml-->
<wxs src='../../utils/format.wxs' module="format"></wxs>
<view class="header">
  <image src="{{songInfo.coverImgUrl}}" mode="aspectFill" class="bg-image" />
  <view class="bg-cover"></view>

  <view class="content">
    <image src="{{songInfo.coverImgUrl}}" mode="aspectFill" class="image" />
    <view class="info">
      <view class="title">{{songInfo.name}}</view>
      <view class="author">
        <image src="{{songInfo.creator.avatarUrl}}" mode="aspectFill" class="avatar" />
        <text class="nickname">{{songInfo.creator.nickname}}</text>
      </view>
      <view class="desc">{{songInfo.description}}</view>
    </view>
  </view>
  <view class="operation">
    <view class="favor item">
      <image src="/assets/images/icon/favorites.png" mode="widthFix" class="icon" />
      <text class="text">{{format.formatCount(songInfo.playCount)}}</text>
    </view>
    <view class="share item">
      <image src="/assets/images/icon/share.png" mode="widthFix" class="icon" />
      <text class="text">分享</text>
    </view>
  </view>
</view>