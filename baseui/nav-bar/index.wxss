/* components/navigation-bar/index.wxss */
.nav-bar {
  display: flex;
  text-align: center;
}
.left,
.right {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 120rpx;
}
.center {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.left-arrow,
.center-title {
  display: none;
}

.left-slot:empty + .left-arrow,
.center-slot:empty + .center-title {
  display: block;
}

.left .left-arrow .icon {
  width: 40rpx;
  display: block;
}
