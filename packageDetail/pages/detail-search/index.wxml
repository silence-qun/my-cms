<!--pages/detail-search/index.wxml-->
<van-search class="search" value='{{searchValue}}' show-action='{{searchValue}}' background="#fafafa" shape='round' bind:change='handleSearchChange' bind:search='handleSearchAction' />

<!-- 热门搜索 -->
<view wx:if="{{!searchValue.length && !suggestSongs.length}}" class="hot">
  <area-header title='热门搜索' showRight='{{false}}'> </area-header>
  <view class="list">
    <block wx:for="{{hotKeywords}}" wx:key="first">
      <view class="tag" data-keyword='{{item.first}}' bind:tap="handleKeywordItemClick">{{item.first}}</view>
    </block>
  </view>
</view>

<!-- 搜索建议 -->
<view wx:elif='{{suggestSongs.length && !resultSongs.length}}' class="suggest">
  <view class="title">搜索“{{searchValue}}”</view>
  <view class="list">
    <block wx:for="{{suggestSongs}}" wx:key="keyword">
      <view class="item" data-keyword='{{item.keyword}}' bind:tap="handleKeywordItemClick">
        <image src="/assets/images/icon/search.png" class="icon" mode="widthFix" />
        <!-- <text class="text">{{item.keyword}}</text> -->
        <rich-text nodes="{{suggestSongsNodes[index]}}"></rich-text>
      </view>
    </block>
  </view>
</view>

<!-- 搜索结果 -->
<view class="result" wx:elif='{{resultSongs.length}}'>
  <view class="title">最佳匹配</view>
  <view class="list">
    <block wx:for="{{resultSongs}}" wx:key="id">
      <song-item-v2 item='{{item}}' index="{{index + 1}}"></song-item-v2>
    </block>
  </view>
</view>