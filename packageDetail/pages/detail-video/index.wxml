<!--pages/detail-video/index.wxml-->
<wxs src='../../../utils/format.wxs' module="format"></wxs>
<video class="video" src="{{mvURLInfo.url}}" autoplay loop referrer-policy="origin" />
<view class="main">
  <view class="title">{{mvDetail.name}}</view>
  <view class="artist">{{mvDetail.artistName}}</view>
  <view class="artist">{{format.formatCount(mvDetail.playCount)}}次播放 — {{mvDetail.publishTime}}</view>
  <view class="recom">推荐视频</view>
  <view class="item" wx:for="{{relatedVideos}}" wx:key="id">
    <video-item-v2 item="{{item}}" bind:tap="handleVideoItemClick" data-item="{{item}}"> </video-item-v2>
  </view>
</view>