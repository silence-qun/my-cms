<!--pages/home-music/index.wxml-->
<van-search disabled placeholder="搜索您喜欢的歌曲" background="#fafafa" shape='round' bind:click-input='handleSearchClick' />

<swiper indicator-dots autoplay circular style='height: {{swiperHeight}}px' class="swiper">
  <block wx:for="{{banners}}" wx:key="bannerId">
    <swiper-item class="swiper-item">
      <image class="swiper-image" src="{{item.pic}}" mode="widthFix" bindload="handleSwiperImageLoaded"></image>
    </swiper-item>
  </block>
</swiper>

<view wx:if="{{recommendSongs.length>0}}" class="recommend-song">
  <area-header title="推荐歌曲" bind:click='handleMoreClick'></area-header>
  <view class="song-list">
    <block wx:for="{{recommendSongs}}" wx:key="id">
      <song-item item="{{item}}" data-index='{{index}}' bind:tap="handleSongItemClick"></song-item>
    </block>
  </view>
</view>

<song-menu-area wx:if="{{hotSongMenu.length>0}}" title='热门歌单' songMenu='{{hotSongMenu}}'></song-menu-area>
<song-menu-area wx:if="{{recommendSongMenu.length>0}}" title='推荐歌单' songMenu='{{recommendSongMenu}}'></song-menu-area>

<view class="ranking">
  <area-header title='巅峰榜' showRight="{{false}}"></area-header>
  <view class="ranking-list">
    <block wx:for="{{rankings}}" wx:key="name">
      <ranking-area-item item="{{item}}" class="ranking-item" data-key='{{index}}' bind:tap="handleRankingItemClick"></ranking-area-item>
    </block>
  </view>
</view>

<!-- 播放工具栏 -->
<view wx:if="{{currentSong.id}}" class="play-bar-placeholder"></view>
<view wx:if="{{currentSong.id}}" class="play-bar" bind:tap="handlePlayBarClick">
  <view class="left">
    <image src="{{currentSong.al.picUrl}}" mode="aspectFill" class="album album-anim" style="animation-play-state: {{playAnimState}};"/>
    <view class="name">{{currentSong.name}}</view>
  </view>
  <view class="right">
    <image src="/assets/images/icon/{{isPlaying ? 'pause' : 'play'}}.png" class="icon play"  catch:tap="handlePlayBtnClick"/>
    <image src="/assets/images/icon/music-list.png" class="icon playList"/>
  </view>
</view>